{
  "version": 2,
  "routes": [
    {
      "src": "/api/parse",
      "dest": "/api/index.js"
    },
    {
      "src": "/api/test",
      "dest": "/api/index.js"
    },
    {
      "src": "/api/pdf",
      "dest": "/api/pdf.py"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/",
      "dest": "/public/index.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}